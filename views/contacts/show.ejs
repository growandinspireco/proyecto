<%- include('../partials/header') %>
<div class="page-head">
  <div class="person">
    <div class="avatar" style="width:48px;height:48px;font-size:17px"><%= initials(fullName(contact)) %></div>
    <div>
      <h1><%= fullName(contact) %></h1>
      <div class="muted">
        <%= fmtPhone(contact.phone) %><%= contact.email ? ' · ' + contact.email : '' %>
        <% if (contact.sms_opt_out) { %> · <span class="badge badge-red">No acepta SMS</span><% } %>
      </div>
    </div>
  </div>
  <div class="actions">
    <% if (contact.phone) { %><a class="btn" href="/conversations/<%= contact.id %>">💬 Conversación</a><% } %>
    <a class="btn" href="/contacts/<%= contact.id %>/edit">Editar</a>
    <% if (isAdmin) { %>
      <form method="post" action="/contacts/<%= contact.id %>/delete" class="inline" data-confirm="¿Eliminar este contacto y todo su historial?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger">Eliminar</button>
      </form>
    <% } %>
  </div>
</div>

<div class="card" style="margin-bottom:16px">
  <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center">
    <strong style="margin-right:8px">Etapa:</strong>
    <% STAGES.forEach(function (s) { %>
      <form method="post" action="/contacts/<%= contact.id %>/stage" class="inline" <% if (s.key === 'perdido') { %>data-prompt="lost_reason" data-prompt-text="¿Por qué se perdió? (opcional)"<% } %> <% if (s.key === 'ganado') { %>data-prompt="deal_value" data-prompt-text="Monto de la venta" data-prompt-default="<%= contact.deal_value || '' %>"<% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="stage" value="<%= s.key %>">
        <button class="btn btn-sm" style="<%= contact.stage === s.key ? `background:${s.color};color:#fff;border-color:${s.color}` : '' %>"><%= s.label %></button>
      </form>
    <% }) %>
  </div>
</div>

<div class="grid grid-side">
  <div>
    <div class="card">
      <h2>Enviar SMS</h2>
      <% if (!contact.phone) { %>
        <div class="muted">Agrega un teléfono para poder enviar SMS.</div>
      <% } else { %>
        <% if (messages.length) { %>
          <div style="max-height:220px; overflow-y:auto; margin-bottom:10px">
            <% messages.forEach(function (m) { %>
              <div class="bubble <%= m.direction %>"><%= m.body %><div class="meta"><%= fmtRelative(m.created_at) %><%= m.direction === 'out' ? ' · ' + msgStatus(m.status) : '' %></div></div>
            <% }) %>
          </div>
        <% } %>
        <div class="templates">
          <% templates.forEach(function (t) { %><button type="button" class="btn btn-sm" data-template="<%= t.body %>" data-target="#sms-body"><%= t.name %></button><% }) %>
        </div>
        <form method="post" action="/contacts/<%= contact.id %>/sms">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><textarea id="sms-body" name="body" maxlength="1600" placeholder="Escribe tu mensaje…" required></textarea></div>
          <button class="btn btn-primary" <%= contact.sms_opt_out ? 'disabled' : '' %>>Enviar SMS</button>
          <% if (!smsLive) { %><span class="small muted">Modo simulación: el SMS se guarda pero no se envía.</span><% } %>
        </form>
      <% } %>
    </div>

    <div class="card">
      <h2>Agendar cita</h2>
      <form method="post" action="/appointments">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="contact_id" value="<%= contact.id %>">
        <input type="hidden" name="redirect" value="contact">
        <div class="row">
          <div class="field"><label>Título</label><input type="text" name="title" value="<%= contact.property_id ? 'Visita a propiedad' : 'Reunión de ventas' %>"></div>
          <div class="field"><label>Fecha y hora *</label><input type="datetime-local" name="starts_at" required></div>
          <div class="field"><label>Duración</label><select name="duration_min"><option value="30">30 min</option><option value="60" selected>1 hora</option><option value="90">1.5 horas</option><option value="120">2 horas</option></select></div>
        </div>
        <div class="row">
          <div class="field"><label>Lugar</label><input type="text" name="location" placeholder="Oficina, Zoom, dirección…"></div>
          <div class="field"><label>Propiedad</label>
            <select name="property_id"><option value="">—</option><% properties.forEach(function (p) { %><option value="<%= p.id %>" <%= contact.property_id === p.id ? 'selected' : '' %>><%= p.title %></option><% }) %></select>
          </div>
          <% if (isAdmin) { %>
            <div class="field"><label>Con</label><select name="user_id"><% users.forEach(function (u) { %><option value="<%= u.id %>" <%= (contact.owner_id || currentUser.id) === u.id ? 'selected' : '' %>><%= u.name %></option><% }) %></select></div>
          <% } %>
        </div>
        <label class="check"><input type="checkbox" name="send_sms" <%= contact.phone && !contact.sms_opt_out ? 'checked' : 'disabled' %>> Enviar SMS de confirmación al cliente</label>
        <div style="margin-top:10px"><button class="btn btn-primary">Agendar</button></div>
      </form>
    </div>

    <div class="card" id="actividad">
      <h2>Actividad</h2>
      <form method="post" action="/contacts/<%= contact.id %>/notes" style="margin-bottom:14px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><textarea name="body" placeholder="Registra una nota, llamada o correo…" required></textarea></div>
        <select name="type" style="width:auto"><option value="nota">Nota</option><option value="llamada">Llamada</option><option value="correo">Correo</option></select>
        <button class="btn">Guardar</button>
      </form>
      <ul class="timeline">
        <% activities.forEach(function (a) { %>
          <li>
            <span class="type"><%= a.type %></span> <span class="small muted">· <%= fmtDateTime(a.created_at) %><%= a.user_name ? ' · ' + a.user_name : '' %></span>
            <div style="white-space:pre-wrap"><%= a.body %></div>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <div>
    <div class="card">
      <h2>Detalles</h2>
      <table>
        <tr><td class="muted">Valor</td><td><strong><%= fmtMoney(contact.deal_value) %></strong></td></tr>
        <tr><td class="muted">Asignado a</td><td><%= owner ? owner.name : '—' %></td></tr>
        <tr><td class="muted">Fuente</td><td><%= contact.source || '—' %></td></tr>
        <tr><td class="muted">Propiedad</td><td><% if (property) { %><a href="/properties/<%= property.id %>"><%= property.title %></a><% } else { %>—<% } %></td></tr>
        <tr><td class="muted">Etiquetas</td><td><% (contact.tags || '').split(',').map(t => t.trim()).filter(Boolean).forEach(function (t) { %><span class="badge"><%= t %></span> <% }) %></td></tr>
        <tr><td class="muted">Creado</td><td><%= fmtDate(contact.created_at) %></td></tr>
        <% if (contact.lost_reason) { %><tr><td class="muted">Motivo perdido</td><td><%= contact.lost_reason %></td></tr><% } %>
      </table>
      <% if (contact.notes) { %><p style="white-space:pre-wrap; margin-bottom:0"><%= contact.notes %></p><% } %>
    </div>

    <div class="card">
      <h2>Citas</h2>
      <% if (!appointments.length) { %><div class="empty">Sin citas.</div><% } %>
      <ul class="list">
        <% appointments.forEach(function (a) { %>
          <li>
            <div><strong><%= a.title %></strong><div class="small muted"><%= fmtDateTime(a.starts_at) %><%= a.user_name ? ' · ' + a.user_name : '' %></div></div>
            <a href="/appointments/<%= a.id %>/edit" class="badge <%= a.status === 'confirmada' ? 'badge-green' : a.status === 'completada' ? 'badge-gray' : ['no_show','cancelada'].includes(a.status) ? 'badge-red' : 'badge-blue' %>"><%= apptStatus(a.status) %></a>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="card">
      <h2>Tareas</h2>
      <ul class="list">
        <% tasks.forEach(function (t) { %>
          <li>
            <div style="<%= t.done ? 'text-decoration:line-through;opacity:.6' : '' %>"><%= t.title %><div class="small muted"><%= t.due_at ? fmtDateTime(t.due_at) : 'sin fecha' %><%= t.user_name ? ' · ' + t.user_name : '' %></div></div>
            <form method="post" action="/tasks/<%= t.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm"><%= t.done ? 'Reabrir' : 'Hecha' %></button></form>
          </li>
        <% }) %>
      </ul>
      <form method="post" action="/contacts/<%= contact.id %>/tasks" style="margin-top:10px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><input type="text" name="title" placeholder="Ej. Llamar para enviar cotización" required></div>
        <div class="field"><input type="datetime-local" name="due_at"></div>
        <% if (isAdmin) { %><div class="field"><select name="user_id"><% users.forEach(function (u) { %><option value="<%= u.id %>" <%= (contact.owner_id || currentUser.id) === u.id ? 'selected' : '' %>><%= u.name %></option><% }) %></select></div><% } %>
        <button class="btn">+ Agregar tarea</button>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
