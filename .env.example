# Copia este archivo como .env y completa los valores.

PORT=3000
# URL pública del CRM (necesaria para Google y para los webhooks de Twilio)
BASE_URL=http://localhost:3000
# Cadena larga y aleatoria. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NODE_ENV=development
APP_NAME=CRM Ventas
CURRENCY=MXN
# Código de país para teléfonos escritos sin "+" (52 = México)
DEFAULT_COUNTRY_CODE=52
# Permitir que cualquiera cree cuenta (por defecto solo el primer usuario; los demás los da de alta el admin)
ALLOW_SIGNUP=false

# --- Inicio de sesión con Google (opcional) ---
# https://console.cloud.google.com/apis/credentials → Crear ID de cliente OAuth (Aplicación web)
# URI de redirección autorizada: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMS con Twilio (opcional; sin esto funciona en modo simulación) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número por defecto si el usuario no tiene uno propio
TWILIO_DEFAULT_NUMBER=
# Horas antes de la cita para enviar el recordatorio automático
REMINDER_HOURS=24

# Ruta de la base de datos (por defecto data/crm.db)
# DATABASE_PATH=
